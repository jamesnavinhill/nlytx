# ============================================================
# Nlytx environment template — copy to .env and fill values.
# Canon source for secrets: C:\Users\james\projects\.auth (env/.env.canonical)
# See docs/environment.md for key-by-key notes and verification status.
# ============================================================

# --- Credential vault ---
# 32-byte random hex; derives the AES-256-GCM master key for in-memory credential storage.
VAULT_ENCRYPTION_KEY=""

# --- Vercel analytics connector ---
# Personal-account token (jamesnavinhill18@gmail.com), canon key VERCEL_JNH_TOKEN
# in projects/.auth — reads the nlytx project itself.
VERCEL_BEARER_TOKEN=""
VERCEL_PROJECT_ID=""

# --- Cloudflare analytics connector ---
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
# navinhill.com zone: 1d561b7ab18fb22c3ecf01acc2210788
CLOUDFLARE_ZONE_ID=""

# --- Google Analytics 4 connector ---
GOOGLE_ANALYTICS_PROPERTY_ID=""
# Base64 of the jami-studio service-account JSON; the service mints short-lived
# SA-JWT access tokens at runtime (GA Data API cannot use static keys).
GOOGLE_ANALYTICS_SA_JSON_B64=""

# --- AWS infrastructure connector (read-only) ---
# Scoped IAM user nlytx-telemetry (AmazonEC2ReadOnlyAccess + CloudWatchReadOnlyAccess).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# --- Neon auth/db (jamesnavinhill18@gmail.com account; verified live via Vercel integration) ---
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
NEON_AUTH_BASE_URL=""
VITE_NEON_AUTH_URL=""
NEON_PROJECT_ID=""
NEON_JWKS_URL=""

# --- Neon S3-compatible storage (NOT AWS credentials) ---
NEON_S3_ENDPOINT_URL=""
NEON_S3_ACCESS_KEY_ID=""
NEON_S3_SECRET_ACCESS_KEY=""

# --- Oracle Cloud infrastructure connector (no creds on disk yet) ---
OCI_TENANCY_OCID=""
OCI_PRIVATE_KEY=""

# --- App ---
APP_URL=""
